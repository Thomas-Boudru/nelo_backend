#!/usr/bin/env node

const app = require("../app");
const http = require("node:http");

const pool = require("../db/pool");

const { startBackgroundWorkers } = require("../services/backgroundWorkers");

const port = normalizePort(process.env.PORT || "3000");

if (port === false) {
  throw new Error("Invalid PORT configuration.");
}

app.set("port", port);

const server = http.createServer(app);

let workers = null;
let shutdownPromise = null;

server.on("error", onError);
server.on("listening", onListening);

process.once("SIGTERM", () => {
  void shutdown("SIGTERM");
});

process.once("SIGINT", () => {
  void shutdown("SIGINT");
});

server.listen(port);

function normalizePort(value) {
  const parsed = parseInt(value, 10);

  if (Number.isNaN(parsed)) return value;
  if (parsed >= 0) return parsed;

  return false;
}

function onError(error) {
  console.error("[HTTP server]", {
    code: error.code || "HTTP_SERVER_FAILED",
  });

  void shutdown("HTTP_ERROR", 1);
}

function onListening() {
  const address = server.address();

  console.info("[HTTP server] listening", {
    port: typeof address === "string" ? address : address?.port,
  });

  if (process.env.BACKGROUND_WORKERS_ENABLED?.trim() === "true") {
    workers = startBackgroundWorkers();
  }
}

function closeHttpServer() {
  return new Promise((resolve, reject) => {
    if (!server.listening) {
      resolve();
      return;
    }

    // Refuse les nouvelles connexions et laisse terminer
    // les requêtes HTTP déjà commencées.
    server.close((error) => {
      if (error) reject(error);
      else resolve();
    });

    server.closeIdleConnections?.();
  });
}

function shutdown(signal, exitCode = 0) {
  if (shutdownPromise) return shutdownPromise;

  console.info("[Server] stopping", { signal });

  /*
   * Limite locale d'arrêt. L'hébergeur peut imposer un délai
   * plus court : les baux PostgreSQL permettent alors
   * de reconnaître les traitements interrompus.
   */
  const deadline = setTimeout(() => {
    console.error("[Server] shutdown deadline exceeded");
    process.exit(1);
  }, 25_000);

  deadline.unref();

  shutdownPromise = (async () => {
    try {
      const results = await Promise.allSettled([
        closeHttpServer(),
        workers ? workers.stop() : Promise.resolve(),
      ]);

      if (results.some((result) => result.status === "rejected")) {
        exitCode = 1;
      }

      // Ferme PostgreSQL uniquement après l'arrêt de l'API
      // et des traitements en cours.
      await pool.end();

      process.exitCode = exitCode;
      console.info("[Server] stopped");
    } catch {
      process.exitCode = 1;
      console.error("[Server] shutdown failed");
    } finally {
      clearTimeout(deadline);
    }
  })();

  return shutdownPromise;
}
